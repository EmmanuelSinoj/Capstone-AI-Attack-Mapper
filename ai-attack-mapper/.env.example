# Copy this file to .env and adjust as needed. .env is gitignored so that
# any locally-tuned values (ports, model choices) don't collide across
# teammates' machines.

# --- Ollama ---
OLLAMA_PORT=11434
OLLAMA_HOST=http://localhost:11434

# Model pulled into the testbed container. Sized for an 8GB-class GPU
# (RTX 5060 laptop). Swap for mistral:7b-instruct-q4_K_M to compare.
TESTBED_MODEL=llama3:8b

# Detection / guard models
# NOTE: the judge model actually wired into detection is Prompt-Guard-86M
# (CPU, via Hugging Face), not llama-guard3:8b -- see
# live_attack_path/detection/judge.py for why. llama-guard3:8b is still
# pulled into Ollama (scripts/pull_models.ps1) in case the team wants to
# swap to it later, but nothing currently calls it.
GUARD_MODEL=llama-guard3:8b

# Prompt-Guard-86M is a *gated* Hugging Face model. Request access at
# huggingface.co/meta-llama/Prompt-Guard-86M, then generate a token at
# huggingface.co/settings/tokens and paste it here. Leave blank to run
# detection in heuristics-only mode (logged clearly when it happens).
HF_TOKEN=

# Classification engine: local model to pilot against Claude Sonnet 5.
CLASSIFIER_MODEL=llama3:8b

# --- Testbed service ---
TESTBED_PORT=8000

# --- Dashboard (read-only ops console over alerts.db + Ollama + testbed) ---
# See live_attack_path/dashboard/README.md. Open http://localhost:8080
# once `docker compose up -d` has the stack running.
DASHBOARD_PORT=8080

# --- Anthropic (only needed if/when the classifier fallback or synthetic
# alert generation calls Claude Sonnet 5 — leave blank until that's wired
# up; never commit a real key) ---
ANTHROPIC_API_KEY=
