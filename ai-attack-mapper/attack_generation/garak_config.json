{
  "rest": {
    "RestGenerator": {
      "uri": "http://localhost:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "prompt": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "$.response",
      "request_timeout": 180
    }
  }
}
